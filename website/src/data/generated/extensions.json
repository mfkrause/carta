  "gaps": [
    {
      "names": [
        "raw_tex"
      ],
      "description": "A raw-TeX environment (`\\begin{…}…\\end{…}`) that interrupts an open paragraph with no blank line leaves that paragraph as `Para` rather than tightening it to `Plain`. The free-standing form (a blank line before the environment) is exact."
    },
    {
      "names": [
        "markdown_in_html_blocks"
      ],
      "description": "A block-level HTML element (`<div>`, `<section>`, `<table>`, …) that interrupts an open paragraph tightens it to `Plain`. Two narrower forms still diverge: a raw-text element (`<pre>`, `<script>`) interrupting a paragraph leaves it as `Para` rather than `Plain`, and an inline-level construct (`<style>`, a comment, a doctype, or a processing instruction) interrupting a paragraph is folded into it as raw inline by the dialect, whereas carta opens a separate raw block."
    },
    {
      "names": [
        "markdown_in_html_blocks"
      ],
      "description": "An HTML block left open at end of input (a `<!-- …` comment or a `<table>`/`<div>` with no close tag) is reparsed as ordinary paragraphs by the dialect; carta keeps the whole run as one raw block."
    },
    {
      "names": [
        "native_spans"
      ],
      "description": "An emphasis run that opens before a `<span>` and whose closing marker sits just inside the matching `</span>` can leave both tags raw instead of forming a span."
    },
    {
      "names": [
        "raw_tex"
      ],
      "description": "Inline `\\command{…}[…]` consumes every group that follows it; commands that take a fixed number of arguments and leave the rest as text are not modeled. A `\\begin{env}…\\end{env}` is recognized only as a whole paragraph (block level); inline, each `\\begin`/`\\end` is an ordinary command."
    },
    {
      "names": [
        "citations"
      ],
      "description": "An abbreviation-led citation suffix such as `p. 5` is a single string in the dialect (a non-breaking space follows the period); carta splits it into separate tokens."
    },
    {
      "names": [
        "attributes"
      ],
      "description": "An attribute spec `{…}` containing a backslash escape is void in the dialect (it stays literal text) whereas carta accepts the backslash into the id, class, or value."
    },
    {
      "names": [
        "alerts"
      ],
      "description": "An alert marker indented two or more columns inside its blockquote (e.g. `>  [!NOTE]`) is still read as an alert; the dialect treats only a marker at column 0 or 1 as one."
    }
  ],
