---
import { extensionsFor } from '../data/extensions';
import { allNames, findFormat, SUPPORT_LABEL } from '../data/formats';
import StatusBadge from './StatusBadge.astro';

interface Props {
  /** Canonical format name as it appears in `docs/status.toml`. */
  format: string;
}

const { format: name } = Astro.props;
const format = findFormat(name);
if (!format) {
  throw new Error(
    `FormatStatus: no format named "${name}" in the generated data; check docs/status.toml`,
  );
}

const extensions = extensionsFor(format.name);
const directions = [
  { label: 'Reading', side: format.read },
  { label: 'Writing', side: format.write },
] as const;
---

<div class="format-status" data-format={format.name}>
  <dl>
    <dt>Names</dt>
    <dd>
      {
        allNames(format).map((alias, index) => (
          <>
            {index > 0 && ' '}
            <code>{alias}</code>
          </>
        ))
      }
    </dd>

    {
      directions.map((direction) => (
        <>
          <dt>{direction.label}</dt>
          <dd>
            <StatusBadge status={direction.side.status} />
            {direction.side.feature && (
              <>
                {' via '}
                <code>{direction.side.feature}</code>
              </>
            )}
            {!direction.side.ships && (
              <span class="muted"> ({SUPPORT_LABEL[direction.side.status].toLowerCase()})</span>
            )}
          </dd>
        </>
      ))
    }

    {
      extensions && (
        <>
          <dt>Extensions</dt>
          <dd>
            {extensions.accepted.length} accepted, {extensions.enabled.length} on by default
          </dd>
        </>
      )
    }
  </dl>
</div>

<style>
  .format-status {
    border: 1px solid var(--carta-border);
    border-radius: var(--carta-radius);
    background: var(--carta-surface);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1.25rem;
    margin: 0;
  }

  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--carta-muted);
    padding-top: 0.15rem;
  }

  dd {
    margin: 0;
  }

  .muted {
    color: var(--carta-muted);
  }
</style>
