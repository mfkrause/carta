---
import {
  binary,
  formatBytes,
  formatRange,
  headline,
  provenance,
  results,
} from "../data/benchmarks";

// Choose landing-page conversions independently of generated measurements.
const FEATURED = [
  { surface: "reader", group: "commonmark → json" },
  { surface: "reader", group: "html → json" },
  { surface: "writer", group: "json → html" },
  { surface: "writer", group: "json → latex" },
];

// Use the largest input to reduce the effect of process startup.
const cases = FEATURED.map(({ surface, group }) => {
  const largest = results
    .filter((entry) => entry.surface === surface && entry.group === group)
    .sort((a, b) => b.bytes - a.bytes)[0];
  if (!largest) {
    throw new Error(`benchmarks.json has no ${surface} results for "${group}"`);
  }
  return largest;
});

// Scale each row separately so faster conversions remain visible.
const share = (entry: (typeof cases)[number]) =>
  (entry.carta_ms / entry.pandoc_ms) * 100;
---

<figure class="speed">
  <ol>
    {cases.map((entry) => (
      <li>
        <div class="case">
          <code>{entry.group}</code>
          <span class="size">{formatBytes(entry.bytes, 0)}</span>
          <strong>{entry.speedup.toFixed(1)}× faster</strong>
        </div>

        <div class="row">
          <span class="who">carta</span>
          <span class="track" title={`carta ${entry.carta_ms} ms`}>
            <span class="fill carta" style={`--w: ${share(entry)}%`} />
          </span>
          <span class="ms">{entry.carta_ms} ms</span>
        </div>

        <div class="row">
          <span class="who">pandoc</span>
          <span class="track" title={`pandoc ${entry.pandoc_ms} ms`}>
            <span class="fill other" style="--w: 100%" />
          </span>
          <span class="ms">{entry.pandoc_ms} ms</span>
        </div>
      </li>
    ))}
  </ol>

  <figcaption>
    <p class="binary">
      Binary size: {formatBytes(binary.carta, 1)} against{" "}
      {formatBytes(binary.pandoc, 1)} ({headline.binaryRatio.toFixed(0)}×
      smaller). Peak memory: {formatRange(headline.memoryRatio)} less.
    </p>
    <p class="note">
      Each row is scaled to itself. carta {provenance.carta} against pandoc{" "}
      {provenance.pandoc}, measured {provenance.date} on {provenance.runner}.
    </p>
  </figcaption>
</figure>

<style>
  figure {
    margin: 0;
  }

  ol {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .case {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .case strong {
    margin-inline-start: auto;
    color: var(--carta-accent-strong);
  }

  .row {
    display: grid;
    grid-template-columns: 4rem 1fr 5.5rem;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.3rem;
  }

  .who,
  .ms,
  .size,
  .note {
    color: var(--carta-muted);
    font-size: 0.8rem;
  }

  .ms {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }

  .track {
    display: block;
    height: 0.6rem;
  }

  .fill {
    display: block;
    height: 100%;
    width: var(--w);
    /* Keep a visible mark even for large speedups. */
    min-width: 2px;
    border-radius: 4px;
  }

  .fill.carta {
    background: var(--carta-accent);
  }

  .fill.other {
    background: var(--carta-track);
  }

  .binary {
    margin: 0 0 0.5rem;
  }

  .note {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 3.5rem 1fr;
    }

    .ms {
      grid-column: 2;
      text-align: start;
    }
  }
</style>
