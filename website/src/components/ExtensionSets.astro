---
import { count, recognizedNotModeled, supported } from "../data/extensions";
---

<h4>Supported</h4>
<p class="tokens">
  {supported.map((name) => <code>{name}</code>)}
</p>

<h4>Recognized, behavior not yet modeled</h4>
<p>
  These names are already recognized internally, but the reader does not yet
  branch on the construct:
</p>
<p class="tokens">
  {recognizedNotModeled.map((name) => <code>{name}</code>)}
</p>

<style>
  .tokens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
</style>
