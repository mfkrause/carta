---
import { gaps } from '../data/extensions';
import { renderInline } from '../data/inline';
---

<div class="scroll">
  <table>
    <thead>
      <tr>
        <th scope="col">Extension</th>
        <th scope="col">Gap</th>
      </tr>
    </thead>
    <tbody>
      {
        gaps.map((gap) => (
          <tr>
            <th scope="row">
              {gap.names.map((name, index) => (
                <>
                  {index > 0 && ' '}
                  <code>{name}</code>
                </>
              ))}
            </th>
            <td set:html={renderInline(gap.description)} />
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    text-align: start;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--carta-border);
    vertical-align: top;
  }

  thead th {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--carta-muted);
  }

  tbody th {
    white-space: nowrap;
  }
</style>
