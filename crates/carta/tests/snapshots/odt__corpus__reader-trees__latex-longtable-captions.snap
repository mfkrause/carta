  </table:table-row>
</table:table>
<text:p text:style-name="First_20_paragraph">See Table <text:a xlink:type="simple" xlink:href="#table" office:name="">
<text:span text:style-name="Definition">1</text:span>
</text:a>.</text:p>
<text:p text:style-name="TableCaption">First line<text:line-break />Second line</text:p>
