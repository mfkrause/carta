---
source: crates/carta/tests/golden_e2e.rs
expression: output
---
[ DefinitionList
    [ ( [ Str "{value}" ]
      , [ [ Para
              [ Str "Definition"
              , Space
              , Str "Cedar"
              , Space
              , Str "Ridge"
              ]
          ]
        ]
      )
    , ( [ Strong [ Str "{value}" ] ]
      , [ [ Para
              [ Str "Strong"
              , Space
              , Str "definition"
              , Space
              , Str "Cedar"
              , Space
              , Str "Ridge"
              ]
          ]
        ]
      )
    , ( [ Link
            ( "" , [ "cross-reference" ] , [] )
            [ Str "target" ]
            ( "#target" , "" )
        ]
      , [ [ Para
              [ Str "Link"
              , Space
              , Str "definition"
              , Space
              , Str "Cedar"
              , Space
              , Str "Ridge"
              ]
          ]
        ]
      )
    , ( [ Span ( "term-id" , [] , [] ) [] ]
      , [ [ Para
              [ Str "Anchor"
              , Space
              , Str "definition"
              , Space
              , Str "Cedar"
              , Space
              , Str "Ridge"
              ]
          ]
        ]
      )
    , ( [ Span
            ( ""
            , [ "icon" ]
            , [ ( "asciidoc-icon" , "user" ) , ( "name" , "heart" ) ]
            )
            [ Str "[heart]" ]
        ]
      , [ [ Para
              [ Str "Icon"
              , Space
              , Str "definition"
              , Space
              , Str "Cedar"
              , Space
              , Str "Ridge"
              ]
          ]
        ]
      )
    , ( [ Note [ Para [ Str "Note" , Space , Str "{value}" ] ] ]
      , [ [ Para
              [ Str "Footnote"
              , Space
              , Str "definition"
              , Space
              , Str "Cedar"
              , Space
              , Str "Ridge"
              ]
          ]
        ]
      )
    , ( [ Span
            ( "" , [ "counter" ] , [ ( "name" , "term" ) ] ) [ Str "1" ]
        ]
      , [ [ Para
              [ Str "Count"
              , Space
              , Span
                  ( "" , [ "counter" ] , [ ( "name" , "term" ) ] )
                  [ Str "2" ]
              ]
          ]
        ]
      )
    , ( [ Span
            ( "" , [ "role" ] , [] )
            [ Str "User" , Space , Str "wrapper" ]
        ]
      , [ [ Para
              [ Str "Wrapper"
              , Space
              , Str "definition"
              , Space
              , Str "Cedar"
              , Space
              , Str "Ridge"
              ]
          ]
        ]
      )
    ]
, Header 1 ( "target" , [] , [] ) [ Str "Target" ]
, Para
    [ Str "See"
    , Space
    , Link
        ( "" , [ "cross-reference" ] , [] )
        [ Str "Target" ]
        ( "#target" , "" )
    , Space
    , Str "and"
    , Space
    , Link
        ( "" , [ "cross-reference" ] , [] )
        [ Str "term-id" ]
        ( "#term-id" , "" )
    , Space
    , Str "and"
    , Space
    , Note [ Para [] ]
    , Str "."
    ]
]
