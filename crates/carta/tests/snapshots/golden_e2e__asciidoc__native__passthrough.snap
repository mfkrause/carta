---
source: crates/carta/tests/golden_e2e.rs
expression: output
---
[ Para
    [ Str "A"
    , Space
    , Str "*literal*"
    , Space
    , Str "and"
    , Space
    , Str "<b>literal</b>"
    , Space
    , Str "word."
    ]
, Para
    [ Str "A"
    , Space
    , Strong [ Str "bold" ]
    , Space
    , Str "word."
    ]
, Para [ Emph [ Str "emphasis" ] ]
, RawBlock (Format "html") "<div>"
, Plain [ Str "Content" ]
, RawBlock (Format "html") "</div>"
, Para
    [ RawInline (Format "html") "<span class=\"red\">"
    , Str "text"
    , RawInline (Format "html") "</span>"
    ]
]
