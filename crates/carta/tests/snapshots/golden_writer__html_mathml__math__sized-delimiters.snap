<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo minsize="240%" maxsize="240%" stretchy="true" form="prefix">⟨</mo><mi>v</mi><mo minsize="240%" maxsize="240%" stretchy="true" form="postfix">⟩</mo></mrow><annotation encoding="application/x-tex">\bigg\langle v \bigg\rangle</annotation></semantics></math>
