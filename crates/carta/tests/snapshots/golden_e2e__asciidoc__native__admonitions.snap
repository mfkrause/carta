source: crates/carta/tests/golden_e2e.rs
expression: output
---
[ Div
    ( "" , [ "note" ] , [] )
    [ Div ( "" , [ "title" ] , [] ) [ Para [ Str "Note" ] ]
    , Para
        [ Str "A"
        , Space
        , Str "simple"
        , Space
        , Str "note."
        , SoftBreak
        , Str "Next"
        , Space
        , Str "line."
        ]
    ]
, Div
    ( "" , [ "warning" ] , [] )
    [ Div
        ( "" , [ "title" ] , [] )
        [ Para
            [ Str "A" , Space , Str "warning" , Space , Str "title" ]
        ]
    , Para [ Str "Danger." ]
    , BulletList
        [ [ Para [ Str "first" ] ] , [ Para [ Str "second" ] ] ]
    ]
, CodeBlock ( "" , [] , [] ) "ordinary listing"
]
