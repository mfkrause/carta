#let authors = ([Ada Lovelace],[Alan Turing],)
#let text-value(value) = {
  if value.has("text") { value.text }
  else if value.has("children") { value.children.map(text-value).join() }
  else if value.has("body") { text-value(value.body) }
  else if value == [ ] { " " }
  else { "" }
}
#set document(title: [A #emph[Grand] "Report"], author: authors.map(text-value).join(", ", last: " & "), keywords: ("analysis","computing",), )
#set page(paper: "us-letter", margin: (x: 1.25in, y: 1.25in), numbering: "1", number-align: center)
#set text(size: 12pt, lang: "en")
#set par(justify: true)
#set table(inset: 6pt, stroke: none)
#set heading(numbering: none)
#let horizontalrule = align(center, line(length: 50%))

#align(center)[#block[
#text(weight: "bold", size: 1.5em)[A #emph[Grand] "Report"#footnote[With thanks to the reviewers.]]
#parbreak()
#text(size: 1.25em)[On Matters of Import]
]]
#grid(columns: (1fr,) * calc.min(3, authors.len()), ..authors.map(name => align(center, name)))
#align(center)[2026-06-20]
#block(inset: 2em)[
*Abstract* #parbreak()
A concise overview of the matters discussed herein.

]
