#let authors = ((name: [Ada Lovelace], affiliation: [], email: []),(name: [Alan Turing], affiliation: [], email: []),)
#let text-value(value) = {
  if value.has("text") { value.text }
  else if value.has("children") { value.children.map(text-value).join() }
  else if value.has("body") { text-value(value.body) }
  else if value == [ ] { " " }
  else { "" }
}
#set document(title: [A #emph[Grand] "Report"], author: authors.map(author => text-value(author.name)).join(", ", last: " & "), keywords: ("analysis","computing",), )
#set page(paper: "us-letter", margin: (x: 1.25in, y: 1.25in), numbering: "1", number-align: center)
#set text(size: 12pt, lang: "en")
#set par(justify: true)
#set table(inset: 6pt, stroke: none)
#set heading(numbering: none)
#let horizontalrule = align(center, line(length: 50%))

#place(top, float: true, scope: "parent", clearance: 4mm, block(below: 1em, width: 100%)[
#align(center)[#block[
#text(weight: "bold", size: 1.5em, hyphenate: false)[A #emph[Grand] "Report"#footnote[With thanks to the reviewers.]]
#parbreak()
#text(weight: "bold", size: 1.25em, hyphenate: false)[On Matters of Import]
]]
#grid(columns: (1fr,) * calc.min(3, authors.len()), row-gutter: 1.5em, ..authors.map(author => align(center)[
#author.name \
#author.affiliation \
#author.email
]))
#align(center)[#block(inset: 1em)[2026-06-20]]
#block(inset: 2em)[
*Abstract* #parbreak()
A concise overview of the matters discussed herein.

]
])
