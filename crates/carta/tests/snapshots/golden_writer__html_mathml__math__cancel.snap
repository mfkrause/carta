<p><math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="updiagonalstrike"><mi>x</mi></menclose><annotation encoding="application/x-tex">\cancel{x}</annotation></semantics></math>
<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="downdiagonalstrike"><mrow><mi>y</mi><mo>+</mo><mi>z</mi></mrow></menclose><annotation encoding="application/x-tex">\bcancel{y+z}</annotation></semantics></math>
<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="updiagonalstrike downdiagonalstrike"><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow></menclose><annotation encoding="application/x-tex">\xcancel{abc}</annotation></semantics></math></p>
