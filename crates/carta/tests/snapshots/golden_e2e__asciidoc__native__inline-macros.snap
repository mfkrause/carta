[ Para
    [ Span ( "" , [ "kbd" ] , [] ) [ Strong [ Str "Ctrl" ] ]
    , Str "+"
    , Span ( "" , [ "kbd" ] , [] ) [ Strong [ Str "Shift" ] ]
    , Str "+"
    , Span ( "" , [ "kbd" ] , [] ) [ Strong [ Str "F" ] ]
    , Space
    , Span
        ( "" , [ "button" ] , [] ) [ Strong [ Str "[Cancel]" ] ]
    , Space
    , Span
